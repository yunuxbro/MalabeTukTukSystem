<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.malabetuktuk.DealersController">
    <children>
        <SplitPane dividerPositions="0.5" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Label text="All Registered Dealers">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Button fx:id="btnSelectRandom" mnemonicParsing="false" onAction="#handleSelectRandomDealers" text="Select 4 Random Dealers" />
                                    </children>
                                </HBox>
                                <TableView fx:id="allDealersTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colAllId" prefWidth="120.0" text="Dealer ID" />
                                        <TableColumn fx:id="colAllName" prefWidth="250.0" text="Dealer Name" />
                                        <TableColumn fx:id="colAllNum" prefWidth="150.0" text="Contact Number" />
                                        <TableColumn fx:id="colAllCity" prefWidth="200.0" text="City / Location" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <Label text="Randomly Selected Dealers (Sorted Alphabetically by Location)">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="randomDealersTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRandomId" prefWidth="120.0" text="Dealer ID" />
                                        <TableColumn fx:id="colRandomName" prefWidth="250.0" text="Dealer Name" />
                                        <TableColumn fx:id="colRandomNum" prefWidth="150.0" text="Contact Number" />
                                        <TableColumn fx:id="colRandomCity" prefWidth="200.0" text="City / Location" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>