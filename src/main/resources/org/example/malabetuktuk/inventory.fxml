<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.malabetuktuk.InventoryController">
    <children>

        <HBox spacing="20.0" style="-fx-border-color: #ccc; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-weight: bold;" text="Total Items:" />
                <Label fx:id="lblTotalItems" text="0" />

                <Label style="-fx-font-weight: bold;" text="Total Inventory Value:" />
                <Label fx:id="lblTotalValue" text="Rs. 0.00" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #ccc; -fx-padding: 10;">
            <children>
                <Label text="Category:" />
                <ComboBox fx:id="cmbCategory" prefWidth="120.0" promptText="All" />

                <Label text="Min Price:" />
                <TextField fx:id="txtMinPrice" prefWidth="60.0" text="0" />

                <Label text="Max Price:" />
                <TextField fx:id="txtMaxPrice" prefWidth="70.0" text="999999" />

                <Label text="Search:" />
                <TextField fx:id="txtKeyword" promptText="ID, Name or Brand..." />

                <Button fx:id="btnSearch" text="Filter" />

                <Button fx:id="btnAddItem" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Add New Item" />
            </children>
        </HBox>

        <VBox style="-fx-border-color: #ff9999; -fx-background-color: #fff0f0; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #cc0000;" text="Low Stock Alerts:" />
                <Label fx:id="lblLowStockItems" text="None" wrapText="true" />
            </children>
        </VBox>

        <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colImg" prefWidth="70.0" text="Image" />
                <TableColumn fx:id="colId" prefWidth="80.0" text="Part ID" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Part Name" />
                <TableColumn fx:id="colCategory" prefWidth="110.0" text="Category" />
                <TableColumn fx:id="colBrand" prefWidth="100.0" text="Brand" />
                <TableColumn fx:id="colPrice" prefWidth="90.0" text="Price" />
                <TableColumn fx:id="colQty" prefWidth="80.0" text="Stock Qty" />
                <TableColumn fx:id="colAction" prefWidth="220.0" text="Actions" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>
